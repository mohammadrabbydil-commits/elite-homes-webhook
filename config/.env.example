# Elite Homes USA - automation POC
# Copy this file to config/.env and fill in the values. Never commit config/.env.

# --- Facebook Graph API (Page posting) ---------------------------------------
# From developers.facebook.com -> your App -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=

# Page access token derived from a long-lived user token.
# Generate with:  python run.py auth --token <short-lived-user-token>
FB_PAGE_ACCESS_TOKEN=

# Numeric ID of the "Elite Homes USA" Page (About -> Page transparency).
FB_PAGE_ID=

# Graph API version to target.
FB_GRAPH_API_VERSION=v21.0

# --- Personal profile (outreach module only) ---------------------------------
# WARNING: credentialed browser automation of a personal profile violates
# Meta's Terms of Service and risks a permanent ban on both the profile and
# any Page it administers. Leave these blank unless you accept that risk.
FB_USER_EMAIL=
FB_USER_PASSWORD=

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=elite2024

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./elite_homes.db

# --- Outreach throttling -----------------------------------------------------
OUTREACH_DAILY_LIMIT=20
OUTREACH_MIN_DELAY_SECONDS=90
OUTREACH_MAX_DELAY_SECONDS=300

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# --- Messenger auto-reply ----------------------------------------------------
# Replies ONLY to people who message the Page first (Meta-sanctioned, 24h window).
# Requires the pages_messaging permission, which needs App Review.
FB_VERIFY_TOKEN=elite-homes-verify
AUTOREPLY_ENABLED=false
AUTOREPLY_MIN_DELAY_SECONDS=90
AUTOREPLY_MAX_DELAY_SECONDS=120
AUTOREPLY_MAX_PER_CONVERSATION=1
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20

# --- AI agent (Messenger conversations) --------------------------------------
# Drives the conversation for a SELL lead's 2nd message onward, in place of
# the rigid scripted flow, with hard guardrails (never states a price, hands
# off when it should). Falls back to the scripted flow automatically if
# disabled, unconfigured, or the API call fails - never a hard dependency.
OPENAI_API_KEY=
AI_AGENT_MODEL=gpt-5.5
AI_AGENT_ENABLED=false
